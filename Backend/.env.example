# Server Port (Render automatically provides PORT in production)
PORT=1000

# MongoDB Connection String (e.g. from MongoDB Atlas)
URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coffeeshop?retryWrites=true&w=majority

# JWT Secret Key
SECRET=your_jwt_secret_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Application URL (for OAuth redirect and CORS)
# Local: http://localhost:5173
# Render Production: https://your-frontend-name.onrender.com
CLIENT_URL=http://localhost:5173

# Backend Live URL (for Google OAuth callback in production)
# Local: http://localhost:1000
# Render Production: https://your-backend-name.onrender.com
BACKEND_URL=http://localhost:1000

# Cloudinary (image hosting — required for production)
# Get these from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
